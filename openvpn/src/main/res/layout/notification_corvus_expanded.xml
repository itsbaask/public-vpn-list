<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notification_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/bg_notification_corvus">

    <!-- Top Row: Logo, Title, Protocol Badge, Turn Off Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Official Corvus VPN Logo -->
        <ImageView
            android:id="@+id/notification_logo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/corvus_logo"
            android:contentDescription="Corvus VPN Logo"
            android:scaleType="fitCenter" />

        <!-- Title & Protocol -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/notification_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌐  Secure Server"
                android:textColor="#EEECE6"
                android:textSize="16sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/notification_proto_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OPENVPN"
                android:textColor="#7C6CF0"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_notification_proto_badge" />
        </LinearLayout>

        <!-- Turn Off Button -->
        <TextView
            android:id="@+id/notification_btn_disconnect"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/notification_turn_off"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_notification_btn_disconnect" />
    </LinearLayout>

    <!-- Bottom Status Row -->
    <TextView
        android:id="@+id/notification_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="● Protected • Encrypted Tunnel Active"
        android:textColor="#00E676"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginTop="10dp"
        android:singleLine="true" />

</LinearLayout>
