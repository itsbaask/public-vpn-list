<?xml version="1.0" encoding="utf-8"?>
<!--
  notification_corvus_collapsed.xml
  Super clean & sleek RemoteViews layout for Corvus VPN notification.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/corvus_collapsed_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:background="@drawable/bg_corvus_notif_card">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Header: Logo + App Name -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_stat_vpn"
                android:tint="@color/corvus_notif_text_secondary"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/corvus_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:textColor="@color/corvus_notif_text_secondary"
                android:text="Corvus VPN" />
        </LinearLayout>

        <!-- Protection Status Line -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <ImageView
                android:id="@+id/corvus_status_dot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:src="@drawable/ic_status_dot"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/corvus_status_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textSize="14sp"
                android:textColor="@color/corvus_notif_text_primary"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Server Name (Without IP) -->
        <TextView
            android:id="@+id/corvus_server_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            android:textColor="@color/corvus_notif_text_secondary"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Action Button (Disconnect / Open App) -->
    <TextView
        android:id="@+id/corvus_action_button"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginStart="12dp"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/corvus_notif_btn_text"
        android:background="@drawable/bg_corvus_notif_button" />

</LinearLayout>
