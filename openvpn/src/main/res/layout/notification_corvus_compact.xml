<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notification_container"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:background="@drawable/bg_notification_corvus">

    <!-- Official Corvus VPN Logo -->
    <ImageView
        android:id="@+id/notification_logo"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:src="@drawable/corvus_logo"
        android:contentDescription="Corvus VPN Logo"
        android:scaleType="fitCenter" />

    <!-- Country & Security Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/notification_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌐  Secure Server"
            android:textColor="#EEECE6"
            android:textSize="15sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/notification_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● Protected • Encrypted"
            android:textColor="#00E676"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Turn Off Button -->
    <TextView
        android:id="@+id/notification_btn_disconnect"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="@string/notification_turn_off"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:background="@drawable/bg_notification_btn_disconnect" />

</LinearLayout>
